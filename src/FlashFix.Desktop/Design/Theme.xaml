<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="CanvasBrush" Color="#0B0B0C" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#151516" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="LineBrush" Color="#343436" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F5F4" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#A1A1A4" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#737377" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#F0F0EE" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#D7D7D5" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#B8B8B6" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#F0F0EE" />

    <Style x:Key="EyebrowTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="90" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    </Style>
    <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    <Style x:Key="PanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
    </Style>
</ResourceDictionary>
