<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="FlashFix_Desktop.Pages.HomePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer Background="{StaticResource CanvasBrush}">
  <StackPanel Padding="42,30,42,50" Spacing="25" MaxWidth="1240" HorizontalAlignment="Stretch">
   <Grid x:Name="HeaderSection"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Spacing="7">
     <TextBlock Text="PAINEL / 01" Style="{StaticResource EyebrowTextStyle}"/>
     <TextBlock Text="Visão Geral" Style="{StaticResource DisplayTextStyle}"/>
     <TextBlock Text="Componentes e uso do sistema, atualizados quando você pedir." Style="{StaticResource PageSubtitleStyle}"/>
    </StackPanel>
    <Button Grid.Column="1" x:Name="RefreshButton" Content="↻  Atualizar dados" Click="RefreshButton_Click"
     Background="#252527" Foreground="White" BorderThickness="0" Padding="17,10" VerticalAlignment="Bottom"/>
   </Grid>

   <Grid x:Name="HeroSection" ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#EEEEEC" CornerRadius="12" Padding="27" RequestedTheme="Light">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="SEU PC / AGORA" Foreground="#66666A" FontSize="11" FontWeight="Bold" CharacterSpacing="70"/>
      <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="6" Margin="0,12,0,18">
       <TextBlock x:Name="DeviceTypeText" Text="Identificando o sistema" Foreground="#141416" FontSize="31" FontWeight="SemiBold"/>
       <TextBlock x:Name="OsText" Text="Lendo informações do Windows…" Foreground="#626267" FontSize="16"/>
      </StackPanel>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="UpdatedText" Text="Iniciando análise" Foreground="#66666A" FontSize="12"/>
       <TextBlock x:Name="LicenseText" Grid.Column="1" Text="Verificando licença" Foreground="#343438" FontSize="12" FontWeight="SemiBold"/>
      </Grid>
     </Grid>
    </Border>
    <Border Grid.Column="1" Background="#1B1B1D" BorderBrush="#353537" BorderThickness="1" CornerRadius="12" Padding="25">
     <StackPanel Spacing="12">
      <TextBlock Text="LEITURA ATUAL" Style="{StaticResource EyebrowTextStyle}"/>
      <TextBlock Text="Como o PC está agora" Foreground="White" FontSize="23" FontWeight="SemiBold"/>
      <TextBlock Text="Os números vêm do Windows e são coletados apenas quando você atualiza esta página."
       Foreground="#AAAAAD" TextWrapping="Wrap" FontSize="13"/>
      <Rectangle Height="1" Fill="#444447" Margin="0,6,0,0"/>
      <TextBlock x:Name="SummaryText" Text="Lendo dados…" Foreground="#EAEAEA" FontSize="13" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
   </Grid>

   <StackPanel x:Name="MetricsSection" Spacing="12">
    <TextBlock Text="USO NESTE MOMENTO" Style="{StaticResource EyebrowTextStyle}"/>
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource PanelStyle}" Padding="18"><StackPanel Spacing="9">
      <TextBlock Text="CPU" Style="{StaticResource EyebrowTextStyle}"/><TextBlock x:Name="CpuPercentText" Text="—" FontSize="31" FontWeight="SemiBold"/>
      <ProgressBar x:Name="CpuBar" Minimum="0" Maximum="100" Value="0" Height="3" Foreground="White"/>
      <TextBlock Text="Carga atual" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
     </StackPanel></Border>
     <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="18"><StackPanel Spacing="9">
      <TextBlock Text="GPU" Style="{StaticResource EyebrowTextStyle}"/><TextBlock x:Name="GpuPercentText" Text="—" FontSize="31" FontWeight="SemiBold"/>
      <ProgressBar x:Name="GpuBar" Minimum="0" Maximum="100" Value="0" Height="3" Foreground="White"/>
      <TextBlock x:Name="GpuNoteText" Text="A verificar" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
     </StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="18"><StackPanel Spacing="9">
      <TextBlock Text="RAM" Style="{StaticResource EyebrowTextStyle}"/><TextBlock x:Name="RamPercentText" Text="—" FontSize="31" FontWeight="SemiBold"/>
      <ProgressBar x:Name="RamBar" Minimum="0" Maximum="100" Value="0" Height="3" Foreground="White"/>
      <TextBlock Text="Memória em uso" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
     </StackPanel></Border>
     <Border Grid.Column="3" Style="{StaticResource PanelStyle}" Padding="18"><StackPanel Spacing="9">
      <TextBlock Text="DISCO" Style="{StaticResource EyebrowTextStyle}"/><TextBlock x:Name="DiskPercentText" Text="—" FontSize="31" FontWeight="SemiBold"/>
      <ProgressBar x:Name="DiskBar" Minimum="0" Maximum="100" Value="0" Height="3" Foreground="White"/>
      <TextBlock Text="Espaço ocupado" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
     </StackPanel></Border>
    </Grid>
   </StackPanel>

   <StackPanel x:Name="HardwareSection" Spacing="12">
    <TextBlock Text="HARDWARE IDENTIFICADO" Style="{StaticResource EyebrowTextStyle}"/>
    <Border Background="#151516" BorderBrush="#343436" BorderThickness="1" CornerRadius="12" Padding="24">
     <StackPanel Spacing="0">
      <Grid ColumnSpacing="20" Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Spacing="6"><TextBlock Text="PROCESSADOR" Style="{StaticResource EyebrowTextStyle}"/><TextBlock x:Name="CpuNameText" Text="Identificando…" Foreground="White" FontSize="16" TextWrapping="Wrap"/></StackPanel>
       <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="PLACA DE VÍDEO" Style="{StaticResource EyebrowTextStyle}"/><TextBlock x:Name="GpuNameText" Text="Identificando…" Foreground="White" FontSize="16" TextWrapping="Wrap"/></StackPanel>
      </Grid>
      <Rectangle Height="1" Fill="#343436"/>
      <Grid ColumnSpacing="20" Margin="0,17,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Spacing="6"><TextBlock Text="MEMÓRIA" Style="{StaticResource EyebrowTextStyle}"/><TextBlock x:Name="MemoryText" Text="Identificando…" Foreground="White" FontSize="16"/></StackPanel>
       <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="ARMAZENAMENTO" Style="{StaticResource EyebrowTextStyle}"/><TextBlock x:Name="StorageText" Text="Identificando…" Foreground="White" FontSize="16"/></StackPanel>
      </Grid>
      <Rectangle Height="1" Fill="#343436"/>
      <Grid ColumnSpacing="20" Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Spacing="6"><TextBlock Text="REDE" Style="{StaticResource EyebrowTextStyle}"/><TextBlock x:Name="NetworkText" Text="Identificando…" Foreground="White" FontSize="16" TextWrapping="Wrap"/></StackPanel>
       <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="TELA" Style="{StaticResource EyebrowTextStyle}"/><TextBlock x:Name="DisplayText" Text="Identificando…" Foreground="White" FontSize="16"/></StackPanel>
      </Grid>
     </StackPanel>
    </Border>
   </StackPanel>
  </StackPanel>
 </ScrollViewer>
</Page>
