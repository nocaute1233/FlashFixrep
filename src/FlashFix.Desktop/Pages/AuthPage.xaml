<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FlashFix_Desktop.Pages.AuthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="AuthRoot">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#171512" Offset="0" />
                <GradientStop Color="#0D0D0E" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.Resources>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#202023" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#3A3A3E" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#59595D" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#252527" />
            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="#252527" />
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="450" />
        </Grid.ColumnDefinitions>

        <Grid Padding="64,56,58,48">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="24" MaxWidth="650" HorizontalAlignment="Left">
                <Border Background="#332C22" CornerRadius="24" HorizontalAlignment="Left" Padding="15,8">
                    <TextBlock Text="UM OLHAR CLARO SOBRE O WINDOWS" Foreground="{StaticResource BrandBrush}"
                               FontSize="10" FontWeight="SemiBold" CharacterSpacing="100" />
                </Border>
                <TextBlock Text="Conheça seu PC.&#10;Decida o que mudar." FontSize="48" FontWeight="SemiBold"
                           LineHeight="61" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" />
                <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="0,8,0,0" />
                <TextBlock Text="Consulte o hardware e as leituras de uso em um só lugar. Nos ajustes disponíveis, veja o valor atual antes de aplicar qualquer mudança."
                           FontSize="16" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                           MaxWidth="520" HorizontalAlignment="Left" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Informações do Windows. Alterações sob seu controle."
                       Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
        </Grid>

        <Border Grid.Column="1" Margin="0,16,16,16" CornerRadius="28"
                BorderThickness="1" BorderBrush="#DDD1BF" RequestedTheme="Light">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F7F2EA" Offset="0" />
                    <GradientStop Color="#EEE7DD" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Padding="48,44,48,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="ACESSO À CONTA" FontSize="11" FontWeight="Bold" CharacterSpacing="90"
                           Foreground="#6E6E70" />

                <StackPanel x:Name="FormPanel" Grid.Row="1" VerticalAlignment="Center" Spacing="18">
                    <StackPanel Spacing="7" Margin="0,0,0,8">
                        <TextBlock x:Name="FormTitle" Text="Acesse sua conta" FontSize="30"
                                   FontWeight="SemiBold" Foreground="#111112" />
                        <TextBlock x:Name="FormSubtitle" Text="Use as credenciais da conta vinculada à sua licença."
                                   FontSize="14" Foreground="#666669" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="7">
                        <TextBlock Text="Nome de usuário" FontSize="12" FontWeight="SemiBold" Foreground="#232326" />
                        <TextBox x:Name="UsernameBox" PlaceholderText="Nome de usuário" Height="46" CornerRadius="10" />
                    </StackPanel>
                    <StackPanel Spacing="7">
                        <TextBlock Text="Senha" FontSize="12" FontWeight="SemiBold" Foreground="#232326" />
                        <PasswordBox x:Name="PasswordInput" PlaceholderText="Senha" Height="46" CornerRadius="10" />
                    </StackPanel>
                    <StackPanel x:Name="KeyField" Spacing="7" Visibility="Collapsed">
                        <TextBlock Text="Chave de ativação" FontSize="12" FontWeight="SemiBold" Foreground="#232326" />
                        <TextBox x:Name="KeyBox" PlaceholderText="FF-XXXXXXXX-XXXXXXXX-XXXXXXXX-XXXXXXXX"
                                 Height="46" CornerRadius="10" />
                    </StackPanel>

                    <TextBlock x:Name="ErrorText" Foreground="#A82424" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <Grid Margin="0,2,0,0">
                        <Button x:Name="SubmitButton" Content="Entrar" Height="48" CornerRadius="11"
                                HorizontalAlignment="Stretch" Background="#101011" Foreground="White"
                                BorderThickness="0" Click="SubmitButton_Click" />
                        <ProgressRing x:Name="LoadingRing" Width="22" Height="22" IsActive="False"
                                      Visibility="Collapsed" HorizontalAlignment="Right" Margin="0,0,16,0" />
                    </Grid>
                    <Button x:Name="ModeButton" Content="Criar conta com uma chave"
                            Background="Transparent" BorderThickness="0" Foreground="#333336"
                            HorizontalAlignment="Left" Padding="0,8" CornerRadius="8" Click="ModeButton_Click" />
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="5">
                    <Rectangle Height="1" Fill="#CECECC" />
                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Sua licença é verificada a cada acesso."
                                   FontSize="11" Foreground="#737376" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Precisa de ajuda? Discord" Click="Support_Click"
                                Background="Transparent" Foreground="#60452B" BorderThickness="0"
                                Padding="0,5" FontSize="11" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
