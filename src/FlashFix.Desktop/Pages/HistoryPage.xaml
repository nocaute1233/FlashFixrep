<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="FlashFix_Desktop.Pages.HistoryPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer Background="{StaticResource CanvasBrush}">
  <StackPanel Padding="42,30,42,50" Spacing="24" MaxWidth="1240" HorizontalAlignment="Stretch">
   <StackPanel x:Name="HeaderSection" Spacing="8">
    <TextBlock Text="ATIVIDADE / RESTAURAÇÃO" Style="{StaticResource EyebrowTextStyle}"/>
    <TextBlock Text="Histórico" Style="{StaticResource DisplayTextStyle}"/>
    <TextBlock Text="Acompanhe o que foi aplicado e volte às configurações originais." Style="{StaticResource PageSubtitleStyle}"/>
   </StackPanel>
   <Border x:Name="RestoreSection" Background="#ECECEA" CornerRadius="12" Padding="25" RequestedTheme="Light">
    <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="7"><TextBlock Text="PONTO DE RETORNO" Foreground="#69696C" FontSize="11" FontWeight="Bold" CharacterSpacing="80"/>
      <TextBlock Text="Seus valores originais estão salvos." Foreground="#161618" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock x:Name="ActiveCountText" Text="Verificando ajustes…" Foreground="#66666A" FontSize="13"/></StackPanel>
     <Button x:Name="RestoreAllButton" Grid.Column="1" Content="Restaurar configurações originais"
      Click="RestoreAll_Click" Background="#161618" Foreground="White" BorderThickness="0"
      Padding="16,11" VerticalAlignment="Center"/>
    </Grid>
   </Border>
   <ProgressBar x:Name="OperationProgress" Minimum="0" Maximum="1" Value="0"
    Visibility="Collapsed" Height="3" Foreground="White"/>
   <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}" FontSize="13" TextWrapping="Wrap"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="REGISTRO DE ALTERAÇÕES" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center"/>
    <Button Grid.Column="1" Content="Atualizar histórico" Click="Refresh_Click"
     Background="#242426" Foreground="White" BorderThickness="0" Padding="14,8"/>
   </Grid>
   <StackPanel x:Name="HistoryList" Spacing="8"/>
  </StackPanel>
 </ScrollViewer>
</Page>
