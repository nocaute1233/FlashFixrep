<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="FlashFix_Desktop.Pages.CrosshairPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer Background="{StaticResource CanvasBrush}">
  <StackPanel Padding="42,30,42,50" Spacing="23" MaxWidth="1240" HorizontalAlignment="Stretch">
   <StackPanel x:Name="HeaderSection" Spacing="8">
    <TextBlock Text="FERRAMENTAS / CROSSHAIR" Style="{StaticResource EyebrowTextStyle}"/>
    <TextBlock Text="Crosshair" Style="{StaticResource DisplayTextStyle}"/>
    <TextBlock Text="Crie e salve perfis de mira. A visualização abaixo fica dentro do FlashFix." Style="{StaticResource PageSubtitleStyle}"/>
   </StackPanel>
   <Grid x:Name="EditorSection" ColumnSpacing="15">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource PanelStyle}" Padding="24">
     <StackPanel Spacing="18">
      <TextBlock Text="EDITOR DE PERFIL" Style="{StaticResource EyebrowTextStyle}"/>
      <StackPanel Spacing="6"><TextBlock Text="Nome do perfil" Foreground="White" FontSize="13"/>
       <TextBox x:Name="NameBox" Text="Nova mira" MaxLength="32" TextChanged="PreviewTextChanged"/></StackPanel>
      <StackPanel Spacing="6"><TextBlock Text="Cor hexadecimal" Foreground="White" FontSize="13"/>
       <TextBox x:Name="ColorBox" Text="#FFFFFF" MaxLength="7" TextChanged="PreviewTextChanged"/></StackPanel>
      <StackPanel Spacing="3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="Tamanho" Foreground="White" FontSize="13"/><TextBlock x:Name="LengthValue" Grid.Column="1" Foreground="{StaticResource MutedTextBrush}"/></Grid>
       <Slider x:Name="LengthSlider" Minimum="4" Maximum="30" Value="15" StepFrequency="1" ValueChanged="PreviewSliderChanged"/></StackPanel>
      <StackPanel Spacing="3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="Espessura" Foreground="White" FontSize="13"/><TextBlock x:Name="ThicknessValue" Grid.Column="1" Foreground="{StaticResource MutedTextBrush}"/></Grid>
       <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="8" Value="3" StepFrequency="1" ValueChanged="PreviewSliderChanged"/></StackPanel>
      <StackPanel Spacing="3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="Espaçamento" Foreground="White" FontSize="13"/><TextBlock x:Name="GapValue" Grid.Column="1" Foreground="{StaticResource MutedTextBrush}"/></Grid>
       <Slider x:Name="GapSlider" Minimum="0" Maximum="20" Value="5" StepFrequency="1" ValueChanged="PreviewSliderChanged"/></StackPanel>
      <StackPanel Spacing="3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="Opacidade" Foreground="White" FontSize="13"/><TextBlock x:Name="OpacityValue" Grid.Column="1" Foreground="{StaticResource MutedTextBrush}"/></Grid>
       <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" Value="100" StepFrequency="5" ValueChanged="PreviewSliderChanged"/></StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <ToggleSwitch x:Name="DotToggle" Header="Ponto central" OnContent="Sim" OffContent="Não" Toggled="PreviewToggleChanged"/>
       <ToggleSwitch x:Name="OutlineToggle" Grid.Column="1" Header="Contorno" IsOn="True" OnContent="Sim" OffContent="Não" Toggled="PreviewToggleChanged"/></Grid>
      <StackPanel Orientation="Horizontal" Spacing="9">
       <Button x:Name="SaveButton" Content="Salvar perfil" Click="Save_Click" Background="#EEEEEC" Foreground="#141416" BorderThickness="0" CornerRadius="9" Padding="17,10"/>
       <Button Content="Novo perfil" Click="New_Click" Background="#29292C" Foreground="White" BorderThickness="0" CornerRadius="9" Padding="17,10"/>
      </StackPanel>
     </StackPanel>
    </Border>
    <StackPanel Grid.Column="1" Spacing="14">
     <Border Background="#111113" BorderBrush="#39393C" BorderThickness="1" CornerRadius="12" Padding="23">
      <StackPanel Spacing="12"><TextBlock Text="PRÉVIA LOCAL" Style="{StaticResource EyebrowTextStyle}"/>
       <Grid Height="270" Background="#222226" CornerRadius="8"><Canvas x:Name="PreviewCanvas" Width="260" Height="260" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
       <TextBlock Text="A sobreposição em jogos ainda não está disponível." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
     </Border>
     <Border Style="{StaticResource PanelStyle}" Padding="22"><StackPanel Spacing="11">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="PERFIS SALVOS" Style="{StaticResource EyebrowTextStyle}"/>
       <Button x:Name="DeleteButton" Grid.Column="1" Content="Excluir" Click="Delete_Click" IsEnabled="False" Background="Transparent" Foreground="#C5C5C7" BorderThickness="0" Padding="3,0"/></Grid>
      <ListView x:Name="ProfileList" SelectionChanged="ProfileList_SelectionChanged" MaxHeight="220"/>
     </StackPanel></Border>
    </StackPanel>
   </Grid>
   <TextBlock x:Name="FeedbackText" Foreground="{StaticResource MutedTextBrush}" FontSize="13" TextWrapping="Wrap"/>
  </StackPanel>
 </ScrollViewer>
</Page>
