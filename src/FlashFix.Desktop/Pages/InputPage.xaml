<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="FlashFix_Desktop.Pages.InputPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer Background="{StaticResource CanvasBrush}">
  <StackPanel Padding="42,30,42,50" Spacing="24" MaxWidth="1240" HorizontalAlignment="Stretch">
   <StackPanel x:Name="HeaderSection" Spacing="8">
    <TextBlock x:Name="EyebrowText" Text="AJUSTES / ENTRADA" Style="{StaticResource EyebrowTextStyle}"/>
    <TextBlock x:Name="TitleText" Text="Mouse" Style="{StaticResource DisplayTextStyle}"/>
    <TextBlock x:Name="SubtitleText" Text="Ajustes do Windows com backup e restauração." Style="{StaticResource PageSubtitleStyle}"/>
   </StackPanel>
   <Border x:Name="NoticeSection" Background="#ECECEA" CornerRadius="12" Padding="23" RequestedTheme="Light">
    <Grid ColumnSpacing="22"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock Text="01 / 02" Foreground="#77777A" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Spacing="5">
      <TextBlock Text="Escolha o que faz sentido para você" Foreground="#161618" FontSize="19" FontWeight="SemiBold"/>
      <TextBlock Text="Confira o valor atual e o efeito de cada opção. Se decidir aplicar, guardaremos a configuração anterior para restaurá-la depois."
       Foreground="#5F5F63" FontSize="13" TextWrapping="Wrap"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="AJUSTES DISPONÍVEIS" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center"/>
    <Button Grid.Column="1" Content="Atualizar estados" Click="Refresh_Click" Background="#242426"
     Foreground="White" BorderThickness="0" Padding="14,8"/>
   </Grid>
   <StackPanel x:Name="TweakList" Spacing="12"/>
   <TextBlock x:Name="FeedbackText" Foreground="{StaticResource MutedTextBrush}" FontSize="13" TextWrapping="Wrap"/>
  </StackPanel>
 </ScrollViewer>
</Page>
