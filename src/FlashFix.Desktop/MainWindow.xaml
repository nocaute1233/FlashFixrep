<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FlashFix_Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FlashFix">
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="FlashFix"
                  IsBackButtonVisible="False" IsPaneToggleButtonVisible="False" />
        <NavigationView x:Name="NavView" Grid.Row="1" Visibility="Collapsed"
                        PaneDisplayMode="Left" OpenPaneLength="252"
                        IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False" SelectionChanged="NavView_SelectionChanged">
            <NavigationView.PaneHeader>
                <StackPanel Margin="20,17,17,21" Spacing="15">
                    <StackPanel Spacing="3">
                        <TextBlock Text="FLASHFIX" FontSize="18" FontWeight="Bold" CharacterSpacing="60"/>
                        <TextBlock Text="ANÁLISE E AJUSTES" FontSize="10" Foreground="{StaticResource SubtleTextBrush}"/>
                    </StackPanel>
                    <Rectangle Height="1" Fill="{StaticResource LineBrush}"/>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.PaneFooter>
                <StackPanel Margin="17,10,14,20" Spacing="5">
                    <TextBlock Text="SOBRE OS AJUSTES" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="Confira cada mudança antes de aplicar." FontSize="11"
                               Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </NavigationView.PaneFooter>
            <Frame x:Name="NavFrame" />
        </NavigationView>
        <Frame x:Name="AuthFrame" Grid.Row="1" />
        <Grid x:Name="TourOverlay" Grid.Row="1" Visibility="Collapsed" Canvas.ZIndex="10"
              Background="#72000000">
            <Grid x:Name="TourCard" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="22" Width="590" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="108" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="8">
                    <Canvas Width="96" Height="124">
                        <Rectangle Width="58" Height="48" RadiusX="12" RadiusY="12" Fill="#EEEEEC"
                                   Canvas.Left="19" Canvas.Top="19" />
                        <Rectangle Width="44" Height="22" RadiusX="7" RadiusY="7" Fill="#151518"
                                   Canvas.Left="26" Canvas.Top="30" />
                        <Ellipse Width="7" Height="7" Fill="#F5F5F3" Canvas.Left="36" Canvas.Top="38" />
                        <Ellipse Width="7" Height="7" Fill="#F5F5F3" Canvas.Left="53" Canvas.Top="38" />
                        <Rectangle Width="2" Height="10" Fill="#EEEEEC" Canvas.Left="47" Canvas.Top="9" />
                        <Ellipse Width="8" Height="8" Fill="#EEEEEC" Canvas.Left="44" Canvas.Top="3" />
                        <Rectangle Width="53" Height="39" RadiusX="12" RadiusY="12" Fill="#EEEEEC"
                                   Canvas.Left="21" Canvas.Top="73" />
                        <Rectangle Width="16" Height="5" RadiusX="2" RadiusY="2" Fill="#151518"
                                   Canvas.Left="40" Canvas.Top="84" />
                        <Rectangle Width="12" Height="4" RadiusX="2" RadiusY="2" Fill="#EEEEEC"
                                   Canvas.Left="12" Canvas.Top="80" />
                        <Rectangle Width="12" Height="4" RadiusX="2" RadiusY="2" Fill="#EEEEEC"
                                   Canvas.Left="72" Canvas.Top="80" />
                    </Canvas>
                    <TextBlock Text="FLASH" Foreground="White" FontSize="11" FontWeight="Bold"
                               CharacterSpacing="80" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="0">
                    <Polygon Points="0,0 15,15 15,0" Fill="#F1F1EF" Width="15" Height="15"
                             HorizontalAlignment="Left" Margin="0,0,0,-1" />
                    <Border Background="#F1F1EF" CornerRadius="16" Padding="24,21" RequestedTheme="Light">
                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="APRESENTAÇÃO DO FLASH" Foreground="#6C6C70" FontSize="10"
                                           FontWeight="Bold" CharacterSpacing="80" />
                                <TextBlock x:Name="TourStepText" Grid.Column="1" Foreground="#6C6C70"
                                           FontSize="11" FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock x:Name="TourTitleText" Foreground="#171719" FontSize="24"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="TourBodyText" Foreground="#4F4F53" FontSize="14"
                                       LineHeight="21" TextWrapping="Wrap" />
                            <Grid Margin="0,8,0,0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button x:Name="TourSkipButton" Content="Pular" Click="TourSkip_Click"
                                        Background="Transparent" Foreground="#555559" BorderThickness="0"
                                        HorizontalAlignment="Left" Padding="4,9" />
                                <Button x:Name="TourBackButton" Grid.Column="1" Content="Voltar" Click="TourBack_Click"
                                        Background="#DCDCD9" Foreground="#1B1B1D" BorderThickness="0"
                                        CornerRadius="8" Padding="15,9" />
                                <Button x:Name="TourNextButton" Grid.Column="2" Content="Avançar" Click="TourNext_Click"
                                        Background="#171719" Foreground="White" BorderThickness="0"
                                        CornerRadius="8" Padding="17,9" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
